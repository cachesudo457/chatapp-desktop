{
  "dist:win": "electron-builder --win --publish=never", "dist:mac": "electron-builder --mac --publish=never", "dist:all": "electron-builder --win --mac --publish=never"

  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.theroom.desktopapp",
    "productName": "The Room",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "build/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "category": "public.app-category.social-networking"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
